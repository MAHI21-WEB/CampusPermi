<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campus.permission.controller.ApprovalController"
            styleClass="root-container">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="top-bar">
            <padding>
                <Insets top="14.0" right="24.0" bottom="14.0" left="24.0"/>
            </padding>
            <Label text="CPMS — Associate Dean Portal" styleClass="top-bar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userNameLabel" styleClass="top-bar-user"/>
            <Label fx:id="roleLabel" styleClass="role-badge"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0" styleClass="content-area">
            <padding>
                <Insets top="22.0" right="24.0" bottom="22.0" left="24.0"/>
            </padding>

            <HBox spacing="14.0">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                    <Label text="Awaiting Final Approval" styleClass="kpi-label"/>
                    <Label fx:id="pendingCountLabel" text="0" styleClass="kpi-value-pending"/>
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                    <Label text="Previously Reviewed" styleClass="kpi-label"/>
                    <Label fx:id="reviewedCountLabel" text="0" styleClass="kpi-value"/>
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                    <Label text="Approved" styleClass="kpi-label"/>
                    <Label fx:id="approvedCountLabel" text="0" styleClass="kpi-value-approved"/>
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                    <Label text="Rejected" styleClass="kpi-label"/>
                    <Label fx:id="rejectedCountLabel" text="0" styleClass="kpi-value-rejected"/>
                </VBox>
            </HBox>

            <VBox spacing="12.0" VBox.vgrow="ALWAYS" styleClass="card-container">
                <padding>
                    <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="DOSA-Forwarded Requests" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Refresh" onAction="#handleRefresh" styleClass="outline-button"/>
                    <Button fx:id="reviewSelectedButton" text="View Details &amp; Decide" onAction="#handleReviewSelected"
                            disable="true" styleClass="primary-button"/>
                </HBox>

                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <Tab text="Awaiting Final Approval">
                        <TableView fx:id="pendingTable">
                            <columns>
                                <TableColumn fx:id="pendingIdColumn" text="ID" prefWidth="70.0"/>
                                <TableColumn fx:id="pendingSocietyColumn" text="Society" prefWidth="200.0"/>
                                <TableColumn fx:id="pendingTitleColumn" text="Request Title" prefWidth="250.0"/>
                                <TableColumn fx:id="pendingCategoryColumn" text="Category" prefWidth="190.0"/>
                                <TableColumn fx:id="pendingEventDateColumn" text="Event Date" prefWidth="120.0"/>
                                <TableColumn fx:id="pendingSubmittedColumn" text="Submitted On" prefWidth="150.0"/>
                            </columns>
                            <placeholder>
                                <Label text="No DOSA-forwarded requests awaiting final decision."/>
                            </placeholder>
                        </TableView>
                    </Tab>
                    <Tab text="Previously Reviewed">
                        <TableView fx:id="reviewedTable">
                            <columns>
                                <TableColumn fx:id="revIdColumn" text="ID" prefWidth="70.0"/>
                                <TableColumn fx:id="revSocietyColumn" text="Society" prefWidth="200.0"/>
                                <TableColumn fx:id="revTitleColumn" text="Request Title" prefWidth="250.0"/>
                                <TableColumn fx:id="revCategoryColumn" text="Category" prefWidth="190.0"/>
                                <TableColumn fx:id="revStatusColumn" text="Current Status" prefWidth="160.0"/>
                                <TableColumn fx:id="revUpdatedColumn" text="Last Updated" prefWidth="150.0"/>
                            </columns>
                            <placeholder>
                                <Label text="No reviewed requests yet."/>
                            </placeholder>
                        </TableView>
                    </Tab>
                </TabPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>
