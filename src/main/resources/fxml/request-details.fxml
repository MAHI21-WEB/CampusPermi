<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campus.permission.controller.RequestDetailsController"
            styleClass="root-container">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="top-bar">
            <padding>
                <Insets top="14.0" right="24.0" bottom="14.0" left="24.0"/>
            </padding>
            <Label text="CPMS — Request Details &amp; Approval Timeline" styleClass="top-bar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back to Dashboard" onAction="#handleBack" styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="root-container">
            <VBox spacing="18.0">
                <padding>
                    <Insets top="22.0" right="24.0" bottom="24.0" left="24.0"/>
                </padding>

                <VBox spacing="14.0" styleClass="card-container">
                    <padding>
                        <Insets top="20.0" right="22.0" bottom="20.0" left="22.0"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label fx:id="requestHeaderLabel" text="Request Details" styleClass="section-title" wrapText="true"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="statusBadgeLabel" text="Status" styleClass="role-badge"/>
                    </HBox>

                    <GridPane hgap="24.0" vgap="10.0">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="140.0"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints prefWidth="140.0"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Society:" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="societyLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Submitted By:" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label fx:id="submittedByLabel" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                        <Label text="Category:" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="categoryLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Submitted On:" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <Label fx:id="submittedAtLabel" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                        <Label text="Event Schedule:" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="scheduleLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
                    </GridPane>

                    <VBox spacing="6.0">
                        <Label text="Description" styleClass="field-label"/>
                        <TextArea fx:id="descriptionArea" editable="false" wrapText="true" prefRowCount="4"
                                  styleClass="text-input"/>
                    </VBox>
                </VBox>

                <VBox spacing="10.0" styleClass="card-container">
                    <padding>
                        <Insets top="18.0" right="22.0" bottom="18.0" left="22.0"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Supporting Attachments" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="openAttachmentButton" text="Open Selected" onAction="#handleOpenAttachment"
                                disable="true" styleClass="outline-button"/>
                    </HBox>
                    <ListView fx:id="attachmentsListView" prefHeight="100.0"/>
                </VBox>

                <VBox spacing="10.0" styleClass="card-container">
                    <padding>
                        <Insets top="18.0" right="22.0" bottom="18.0" left="22.0"/>
                    </padding>
                    <Label text="Approval History" styleClass="section-title"/>
                    <TableView fx:id="historyTable" prefHeight="190.0">
                        <columns>
                            <TableColumn fx:id="levelColumn" text="Approval Level" prefWidth="150.0"/>
                            <TableColumn fx:id="approverColumn" text="Authority" prefWidth="180.0"/>
                            <TableColumn fx:id="decisionColumn" text="Decision" prefWidth="110.0"/>
                            <TableColumn fx:id="remarksColumn" text="Remarks" prefWidth="360.0"/>
                            <TableColumn fx:id="decisionDateColumn" text="Decision Date" prefWidth="150.0"/>
                        </columns>
                        <placeholder>
                            <Label text="No approval decisions recorded yet."/>
                        </placeholder>
                    </TableView>
                    <Label text="Activity Timeline" styleClass="field-label"/>
                    <TextArea fx:id="timelineArea" editable="false" wrapText="true" prefRowCount="4"
                              styleClass="text-input"/>
                </VBox>

                <VBox fx:id="decisionPanel" spacing="10.0" styleClass="card-container">
                    <padding>
                        <Insets top="18.0" right="22.0" bottom="18.0" left="22.0"/>
                    </padding>
                    <Label text="Review Decision" styleClass="section-title"/>
                    <Label text="Add remarks (mandatory if rejecting) and select your decision." styleClass="muted-text"/>
                    <TextArea fx:id="remarksArea" prefRowCount="3" wrapText="true"
                              promptText="Enter approval or rejection remarks..." styleClass="text-input"/>
                    <Label fx:id="decisionErrorLabel" styleClass="error-banner" wrapText="true" maxWidth="Infinity"/>
                    <HBox spacing="12.0" alignment="CENTER_RIGHT">
                        <Button text="Reject Request" onAction="#handleReject" styleClass="danger-button"/>
                        <Button text="Approve Request" onAction="#handleApprove" styleClass="approve-button"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
