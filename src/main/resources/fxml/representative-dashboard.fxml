<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campus.permission.controller.DashboardController"
            styleClass="root-container">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="top-bar">
            <padding>
                <Insets top="14.0" right="24.0" bottom="14.0" left="24.0"/>
            </padding>
            <Label text="CPMS — Representative Portal" styleClass="top-bar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userNameLabel" styleClass="top-bar-user"/>
            <Label fx:id="roleLabel" styleClass="role-badge"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0" styleClass="content-area">
            <padding>
                <Insets top="22.0" right="24.0" bottom="22.0" left="24.0"/>
            </padding>

            <HBox spacing="14.0">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                    <Label text="Total Requests" styleClass="kpi-label"/>
                    <Label fx:id="totalCountLabel" text="0" styleClass="kpi-value"/>
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                    <Label text="Pending Review" styleClass="kpi-label"/>
                    <Label fx:id="pendingCountLabel" text="0" styleClass="kpi-value-pending"/>
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                    <Label text="Approved" styleClass="kpi-label"/>
                    <Label fx:id="approvedCountLabel" text="0" styleClass="kpi-value-approved"/>
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                    <Label text="Rejected" styleClass="kpi-label"/>
                    <Label fx:id="rejectedCountLabel" text="0" styleClass="kpi-value-rejected"/>
                </VBox>
            </HBox>

            <VBox spacing="12.0" VBox.vgrow="ALWAYS" styleClass="card-container">
                <padding>
                    <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Society Permission Requests" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="statusFilterCombo" prefWidth="200.0"/>
                    <Button text="Refresh" onAction="#handleRefresh" styleClass="outline-button"/>
                    <Button text="Export Backup" onAction="#handleExportBackup" styleClass="outline-button"/>
                    <Button fx:id="viewDetailsButton" text="View Details" onAction="#handleViewDetails"
                            disable="true" styleClass="outline-button"/>
                    <Button fx:id="submitDraftButton" text="Submit Draft" onAction="#handleSubmitDraft"
                            disable="true" styleClass="outline-button"/>
                    <Button text="+ New Request" onAction="#handleNewRequest" styleClass="primary-button"/>
                </HBox>

                <TableView fx:id="requestsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="70.0"/>
                        <TableColumn fx:id="titleColumn" text="Request Title" prefWidth="260.0"/>
                        <TableColumn fx:id="categoryColumn" text="Category" prefWidth="210.0"/>
                        <TableColumn fx:id="eventDateColumn" text="Event Date" prefWidth="120.0"/>
                        <TableColumn fx:id="statusColumn" text="Current Status" prefWidth="170.0"/>
                        <TableColumn fx:id="createdColumn" text="Submitted On" prefWidth="150.0"/>
                    </columns>
                    <placeholder>
                        <Label text="No permission requests found for your society."/>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
