<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campus.permission.controller.RequestController"
            styleClass="root-container">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="top-bar">
            <padding>
                <Insets top="14.0" right="24.0" bottom="14.0" left="24.0"/>
            </padding>
            <Label text="CPMS — New Permission Request" styleClass="top-bar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back to Dashboard" onAction="#handleCancel" styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="16.0">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
            </padding>

            <VBox spacing="14.0" maxWidth="680.0" styleClass="card-container">
                <padding>
                    <Insets top="24.0" right="28.0" bottom="24.0" left="28.0"/>
                </padding>

                <Label text="Permission Request Details" styleClass="section-title"/>
                <Label text="Fill in the details below. You can save a draft or submit directly to your Faculty Advisor."
                       styleClass="muted-text" wrapText="true"/>

                <VBox spacing="6.0">
                    <Label text="Permission Category *" styleClass="field-label"/>
                    <ComboBox fx:id="categoryCombo" promptText="Select a permission category" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="6.0">
                    <Label text="Request Title *" styleClass="field-label"/>
                    <TextField fx:id="titleField" promptText="e.g. Main Auditorium Booking for Hackathon"
                               styleClass="text-input"/>
                </VBox>

                <VBox spacing="6.0">
                    <Label text="Description &amp; Additional Details *" styleClass="field-label"/>
                    <TextArea fx:id="descriptionArea" prefRowCount="4" wrapText="true"
                              promptText="Include venue, expected participants, budget, equipment, or guest details as applicable."
                              styleClass="text-input"/>
                </VBox>

                <HBox spacing="14.0">
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="Event / Activity Date" styleClass="field-label"/>
                        <DatePicker fx:id="eventDatePicker" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="Start Time (HH:mm)" styleClass="field-label"/>
                        <TextField fx:id="startTimeField" promptText="09:00" styleClass="text-input"/>
                    </VBox>
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="End Time (HH:mm)" styleClass="field-label"/>
                        <TextField fx:id="endTimeField" promptText="17:00" styleClass="text-input"/>
                    </VBox>
                </HBox>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Button text="Attach Supporting Document" onAction="#handleChooseAttachment" styleClass="outline-button"/>
                    <Label fx:id="attachmentNameLabel" text="No file selected (optional)" styleClass="muted-text"/>
                </HBox>

                <Label fx:id="errorLabel" styleClass="error-banner" wrapText="true" maxWidth="Infinity"/>

                <HBox spacing="10.0" alignment="CENTER_RIGHT">
                    <Button text="Cancel" onAction="#handleCancel" styleClass="outline-button"/>
                    <Button text="Save as Draft" onAction="#handleSaveDraft" styleClass="outline-button"/>
                    <Button text="Submit Request" onAction="#handleSubmitRequest" styleClass="primary-button"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
